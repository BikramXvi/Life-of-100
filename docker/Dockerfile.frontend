# Stage 1 -- build the static Vite bundle. VITE_API_BASE_URL is baked in
# from frontend/.env at this step (Vite reads it automatically); it's a
# public API base URL, not a secret, so it's fine to bake into the bundle.
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2 -- serve the built static files. A React Router SPA needs the
# fallback-to-index.html rule in nginx.frontend.conf, not nginx's default.
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1/health || exit 1
