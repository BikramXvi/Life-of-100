# Copy this file to .env and fill in real values. Never commit .env.

# --- Simulation ---
SIMULATION_SEED=847291
POPULATION_SIZE=100

# --- Postgres (operational state) ---
DATABASE_URL=postgresql+psycopg://life100:life100@localhost:5432/life100

# --- Redpanda / Kafka (event streaming) ---
KAFKA_BROKER=localhost:19092

# --- DuckDB (analytical warehouse — default for this submission, see SCOPE.md) ---
DUCKDB_PATH=./warehouse.duckdb

# --- Snowflake (optional real alternative — POST /warehouse/build-snowflake) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
# Created automatically (XSMALL, auto-suspend 60s) on first use if blank/missing:
SNOWFLAKE_WAREHOUSE=LIFE100_WH
SNOWFLAKE_DATABASE=LIFE100_DB
SNOWFLAKE_SCHEMA=PUBLIC

# --- Gemini (runtime AI agents — see SCOPE.md for why Gemini instead of Anthropic) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- API ---
API_BASE_URL=http://localhost:8000
