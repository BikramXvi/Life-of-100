# Copy this file to .env and fill in real values. Never commit .env.

# --- Simulation ---
SIMULATION_SEED=847291
POPULATION_SIZE=100

# --- Postgres (operational state) ---
DATABASE_URL=postgresql+psycopg://life100:life100@localhost:5432/life100

# --- Redpanda / Kafka (event streaming) ---
KAFKA_BROKER=localhost:19092

# --- DuckDB (analytical warehouse — Snowflake stand-in, see SCOPE.md) ---
DUCKDB_PATH=./warehouse.duckdb

# --- Gemini (runtime AI agents — see SCOPE.md for why Gemini instead of Anthropic) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- API ---
API_BASE_URL=http://localhost:8000
